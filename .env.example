# ─── Database ───
DB_USERNAME=magazyn
DB_PASSWORD=change_this_strong_password
JWT_SECRET=change_this_to_a_random_string_at_least_32_characters_long
JWT_EXPIRATION=86400000

# ─── Default user password (dev only, for user seeding) ───
DEFAULT_USER_PASSWORD=change_me

# ─── KSeF (optional) ───
# Set COMPANY_NIP to enable KSeF integration. Must be a 10-digit Polish NIP.
COMPANY_NIP=
KSEF_API_KEY=
KSEF_API_URL=https://ksef-test.mf.gov.pl/api/v1
KSEF_ENCRYPTION_KEY=

# ─── Mail / Notifications (optional) ───
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
NOTIFICATIONS_ENABLED=false

# ─── AI Assistant / DeepSeek (optional) ───
DEEPSEEK_API_KEY=
ASSISTANT_MODEL=deepseek-chat
ASSISTANT_API_URL=https://api.deepseek.com
